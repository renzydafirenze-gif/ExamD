# ============================================================
# ExamD - Contoh konfigurasi environment
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
# ============================================================

# --- Database PostgreSQL (WAJIB) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Lokal : postgresql://postgres:postgres@localhost:5432/examd
# Neon  : postgresql://user:pass@ep-xxx-123456.ap-southeast-1.aws.neon.tech/examd?sslmode=require
# Supab : postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/examd

# --- Keamanan session (WAJIB diganti di produksi) ---
# Buat string acak panjang, contoh: openssl rand -base64 32
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# --- Opsional ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# NODE_ENV=production
# PORT=3000
# DB_AUTOINIT=1   # buat tabel + seed saat request pertama (sekali pakai; biarkan mati di produksi)
